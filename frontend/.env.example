# ---------------------------------------------------------------------------
# frontend/.env.example  --  copy to .env.local for a local override.
#
# Vite only exposes VITE_-prefixed variables to client code, and INLINES them
# into the shipped bundle at build time. Never put a secret in this file, and
# remember that changing one of these on Vercel requires a redeploy -- editing
# the env var alone does nothing to an already-built bundle.
# ---------------------------------------------------------------------------

# Absolute origin of the FastAPI backend, no trailing slash.
#
# LEAVE THIS UNSET for the default deployment: every request stays a
# same-origin relative "/api/*" path, which vite.config.ts proxies in dev and
# vercel.json rewrites to Render in production. No CORS involved.
#
# Set it only to bypass Vercel's proxy hop and call Render straight from the
# browser -- then the backend must list this Vercel origin in its
# CORS_ALLOW_ORIGINS (backend/config/env.py), or every request fails preflight.
# VITE_API_BASE_URL=https://citimart3-store-backend.onrender.com

# Where `npm run dev`'s /api proxy points. Defaults to the local uvicorn
# (http://127.0.0.1:8000); point it at Render to develop the UI against live
# data without running the backend locally. Dev server only -- unused in a build.
# VITE_DEV_API_PROXY=https://citimart3-store-backend.onrender.com
