# Copy to .env and fill in. Historical Analytics and Forecasting work with
# NONE of these set (they read DATASET.xlsx only). MongoDB is required for
# Daily Operations AND for logging in (the `users` collection).

# ---------------------------------------------------------------------------
# MongoDB (login credentials + Daily Operations data)
# ---------------------------------------------------------------------------
# Atlas SRV string or a plain mongodb:// URI. Unset => Daily Ops falls back to
# the local TEST_DAILY_DASHBOARD.xlsx shim (db/xlsx_fallback.py) and LOGIN
# DOES NOT WORK. Set this for any real use.
#
# Atlas Network Access: the cluster must allow the app's outbound IP. If the
# host has no static egress IP, the allowlist has to be 0.0.0.0/0
# (connections are still gated by the DB user's password + TLS).
# Prefer a least-privilege DB user (readWrite on this DB only, not atlasAdmin).
MONGODB_URI=
MONGODB_DB_NAME=citimart

# ---------------------------------------------------------------------------
# JWT authentication
# ---------------------------------------------------------------------------
# HS256 secret that signs and verifies every session token. A safe insecure
# default exists in code so a fresh clone + `pytest` works; ALWAYS override
# this in production with a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app REFUSES TO START if MONGODB_URI is set but this is left as the code
# default (config/env.assert_production_secrets).
JWT_SECRET=
# Access-token lifetime in seconds (default 43200 = 12h).
JWT_TTL_SECONDS=43200

# ---------------------------------------------------------------------------
# First-run account seeding (scripts/seed_users.py, and app.py on startup).
# Leave these blank to seed the credentials the developer distributes to the
# admin and the three store managers (config/auth_users.DEFAULT_PASSWORDS).
# Set one only to override that account's first-run password with something
# else. Each value must satisfy src/password_policy.py.
# Seeding is idempotent and never overwrites an account that already exists.
# The resulting passwords are written to the gitignored CREDENTIALS.txt.
# ---------------------------------------------------------------------------
ADMIN_INITIAL_PASSWORD=
MANAGER_NM_INITIAL_PASSWORD=
MANAGER_HB_INITIAL_PASSWORD=
MANAGER_CHW_INITIAL_PASSWORD=
